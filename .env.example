NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://localhost:27017/crichost?replicaSet=rs0
REDIS_URL=redis://localhost:6379
AUCTION_TIMER_POLL_MS=1000
OUTBOX_POLL_INTERVAL_MS=750
OUTBOX_HEARTBEAT_INTERVAL_MS=30000
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=12
REALTIME_PORT=4100
REALTIME_MAX_STREAMS=2000
REALTIME_MAX_STREAMS_PER_IP=10
API_PUBLIC_BASE_URL=http://localhost:4000
SESSION_ACCESS_MINUTES=15
SESSION_REFRESH_DAYS=30
BCRYPT_ROUNDS=12
IDENTITY_EXPOSE_DEV_TOKENS=true
ASSET_STORAGE_DIR=./var/assets
ASSET_UPLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
ASSET_MAX_UPLOAD_BYTES=5242880
ASSET_UPLOAD_TTL_SECONDS=600
# Optional malware scan service; leave unset to keep uploaded assets pending.
# ASSET_CLAMAV_HOST=127.0.0.1
ASSET_CLAMAV_PORT=3310
